<?xml version="1.0" encoding="utf-8" ?>
<customUI xmlns='http://schemas.microsoft.com/office/2009/07/customui' loadImage='LoadImage' onLoad='OnLoad'>
	<ribbon>
		<tabs>
			<tab id="tab1" label="Radiant">
				<!--测试专用 后期移出-->
				<group id="TextGruop" label="测试">
					<button id="TestButton"  onAction="TestAction" getImage="获取按钮图片"  size="large" getEnabled='GetButtonEnabled' getLabel='获取文本文字' />
					<button id="GenerateButton" label="生成数据" onAction="生成Action" image="测试" getEnabled='GetButtonEnabled' />
				</group>
				<!-- ===================== 工作簿操作 ===================== -->
				<group id="WorkbookGroup" label="工作簿操作">
					<menu id="PasswordMenu" label="密码破解" image="破解密码" getEnabled='GetButtonEnabled'>
						<button id="CrackWorkbookPassword" label="破解工作薄密码" onAction="破解工作薄密码" image="破解密码" screentip="清除工作簿密码" />
						<button id="CrackVBEPassword" label="破解VBA密码" onAction="破解VBA密码" image="破解密码" screentip="清除VBE密码" />
					</menu>
				</group>

				<!-- ===================== 工作表操作 ===================== -->
				<group id="WorksheetGroup" label="工作表操作">
					<button id="InsertRowButton" label="隔行插入" onAction="InsertRowRange" image="插入行" size="normal" getEnabled='GetButtonEnabled' />
					<button id="InsertColButton" label="隔列插入" onAction="InsertColRange" image="插入列" size="normal" getEnabled='GetButtonEnabled' />
					<menu id="CommentMenu" label="批注管理" image="添加批注" getEnabled="GetButtonEnabled">
						<button id="AddComment" label="添加批注" onAction="添加批注" image="添加批注" screentip="添加单个批注" getEnabled='GetButtonEnabled' />
						<button id="DeleteComment" label="删除批注" onAction="删除批注" image="删除批注" />
						<button id="DeleteAllComments" label="删除所有批注" onAction="删除所有批注" image="删除批注" />
					</menu>
				</group>

				<!-- ===================== 数据操作 ===================== -->
				<group id="DataGroup" label="数据操作">
					<button id="CalculateButton" label="名字填充" onAction="计算Action" image="填充选择" size="normal" getEnabled="GetButtonEnabled" />
					<button id="SameItemButton" label="相同项对比" onAction="相同项对比" image="数据对比" size="normal" screentip="两个表格查到相同项和不同项" getEnabled="GetButtonEnabled" />
					<button id="StatisticsButton" label="统计计算" onAction="数据统计" image="统计计算" size="normal" screentip="点击以后开始统计数据" getEnabled="GetButtonEnabled" />
				</group>

				<!-- ===================== 媒体操作 ===================== -->
				<group id="MediaGroup" label="媒体操作">
					<menu id="ImageMenu" label="图片管理" image="图片" getEnabled='GetButtonEnabled'>
						<button id="InsertImage" label="插入图片" onAction="插入图片" image="插入图片" screentip="插入图片" getEnabled="GetButtonEnabled" />
						<button id="BatchInsertImage" label="批量插入图片" onAction="批量插入图片" image="插入图片" screentip="批量插入图片" getEnabled="GetButtonEnabled" />
						<button id ="OCRImage" label="识别图片" onAction="识别图片" image="插入图片" screentip="识别图片" getEnabled="GetButtonEnabled" />
					</menu>
				</group>

				<!-- ===================== 附加操作 ===================== -->
				<group id="AdditionalGroup" label="附加操作">
					<menu id="BarcodeMenu" label="条码生成" image="条形码" getEnabled="GetButtonEnabled">
						<button id="GenerateBarcode" label="条形码" onAction="生成条形码" image="条形码" screentip="生成条形码" />
						<button id="GenerateQRCode" label="二维码" onAction="生成二维码" image="二维码" screentip="生成二维码" />
						<button id="BatchGenerateBarcode" label="批量生成条码" onAction="批量生成条形码" image="二维码" screentip="批量生成条形码" />
					</menu>
				</group>
				<!--
				<group id="WebGroup" label="网页操作">
					<button id="GenerateWebPage" label="打开网页" onAction="打开网页" image="Image1" size="normal" getEnabled="GetButtonEnabled" />
				</group>
				-->
				<!-- ===================== 系统管理 ===================== -->
				<group id="SystemGroup" label="系统管理">
					<button id="RegisterButton" label="注册" onAction="注册" image="注册" size="large" screentip="注册后解锁全部功能" />
					<button id="UnregisterButton" label="取消注册" onAction="取消注册" image="取消注册" size="large" screentip="移除产品授权" />
					<button id="HelpButton" label="关于" onAction="About" image="联系人" size="normal" screentip="技术支持：122312215413" />
				</group>
			</tab>
		</tabs>
	</ribbon>
</customUI>